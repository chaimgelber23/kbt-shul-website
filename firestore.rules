rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own progress data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Enhanced shiurim mapping - public read (server reads via Admin SDK bypass rules,
    // but this allows client-side reads too if needed)
    match /enhancedShiurim/{docId} {
      allow read: if true;
      allow write: if false; // Only writable by Admin SDK (enhancement script)
    }
  }
}
